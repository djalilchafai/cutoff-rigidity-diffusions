module

public import CutoffRigidity.LangevinConditionalCompensator
public import Mathlib.Probability.Martingale.Basic

/-! # History filtration and adapted actual path compensators

The filtration is generated by the actual measurable continuous driving
history. Nonanticipativity proves adaptation of both the actual continuous
Langevin state and its time-integrated generator compensator.
-/

public section

namespace CutoffRigidity

open Set MeasureTheory ProbabilityTheory
open scoped NNReal Topology

variable {Ω : Type*} [MeasurableSpace Ω] {d : ℕ}
local notation "E" => EuclideanSpace ℝ (Fin d)

@[expose] def drivingHistory (C : Ω → C(ℝ, E)) (t : ℝ≥0) : Ω → C(Icc 0 (t : ℝ), E) :=
  fun ω => (C ω).restrict (Icc 0 (t : ℝ))

theorem drivingHistory_measurable {C : Ω → C(ℝ, E)} (hC : Measurable C) (t : ℝ≥0) :
    Measurable (drivingHistory C t) := (ContinuousMap.continuous_restrict _).measurable.comp hC

omit [MeasurableSpace Ω] in
/-- The actual sigma algebra generated by the driving history is increasing. -/
theorem drivingHistory_sigma_mono (C : Ω → C(ℝ, E)) {s t : ℝ≥0} (hst : s ≤ t) :
    MeasurableSpace.comap (drivingHistory C s) inferInstance ≤
      MeasurableSpace.comap (drivingHistory C t) inferInstance := by
  let incl : C(Icc 0 (s : ℝ), Icc 0 (t : ℝ)) :=
    ⟨fun r => ⟨r, ⟨r.property.1, r.property.2.trans (show (s : ℝ) ≤ t from hst)⟩⟩,
      by fun_prop⟩
  let Φ : C(Icc 0 (t : ℝ), E) → C(Icc 0 (s : ℝ), E) := fun w => w.comp incl
  have hmΦ : Measurable Φ := ContinuousMap.measurable_iff_eval.mpr (fun r =>
    ContinuousMap.measurable_eval (incl r))
  have hmeas : Measurable[MeasurableSpace.comap (drivingHistory C t) inferInstance] (drivingHistory C s) :=
    hmΦ.comp (comap_measurable (drivingHistory C t))
  exact hmeas.comap_le

/-- Genuine history filtration of a measurable continuous driving version. -/
@[expose] def drivingHistoryFiltration {C : Ω → C(ℝ, E)} (hC : Measurable C) :
    Filtration ℝ≥0 ‹MeasurableSpace Ω› where
  seq t := MeasurableSpace.comap (drivingHistory C t) inferInstance
  mono' _ _ hst := drivingHistory_sigma_mono C hst
  le' t := (drivingHistory_measurable hC t).comap_le

/-- Constant extension of a compact history, bundled as an actual continuous path. -/
@[expose] noncomputable def historyNoiseExtension (t : ℝ≥0) (w : C(Icc 0 (t : ℝ), E)) : C(ℝ, E) :=
  ⟨intervalNoiseExtension t.property w, intervalNoiseExtension_continuous t.property w⟩

theorem historyNoiseExtension_measurable (t : ℝ≥0) : Measurable (historyNoiseExtension (d := d) t) := by
  apply ContinuousMap.measurable_iff_eval.mpr
  intro r
  exact ContinuousMap.measurable_eval (projIcc 0 (t : ℝ) t.property r)

/-- The actual continuous solution is strongly adapted to its driving history. -/
theorem continuousLangevinVersion_stronglyAdapted
    {V : E → ℝ} (hV : ContDiff ℝ 2 V) (κ : ℝ) (hκ : 0 ≤ κ)
    (hHess : ∀ x z, κ * ‖z‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ V) x z z)
    {C : Ω → C(ℝ, E)} (hC : Measurable C) (x₀ : E) :
    StronglyAdapted (drivingHistoryFiltration hC) (continuousLangevinVersion V C x₀) := by
  intro t
  have hmA : Measurable (fun w : C(Icc 0 (t : ℝ), E) => intervalLangevinEvaluation V t.property (x₀, w)) :=
    ((intervalLangevinEvaluation_continuous hV κ hκ hHess t.property).comp
      (continuous_const.prodMk continuous_id)).measurable
  have heq : continuousLangevinVersion V C x₀ t =
      fun ω => intervalLangevinEvaluation V t.property (x₀, drivingHistory C t ω) := by
    funext ω
    exact continuousLangevinVersion_eq_history_evaluation hV κ hκ hHess C x₀ t ω
  rw [heq]
  exact (hmA.comp (comap_measurable (drivingHistory C t))).stronglyMeasurable

/-- An actual time-integrated test of the continuous solution is adapted,
proved by restricting and extending the actual noise history. -/
theorem continuousLangevinVersion_integral_stronglyMeasurable_history
    {V g : E → ℝ} (hV : ContDiff ℝ 2 V) (hg : Continuous g)
    (κ : ℝ) (hκ : 0 ≤ κ)
    (hHess : ∀ x z, κ * ‖z‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ V) x z z)
    {C : Ω → C(ℝ, E)} (hC : Measurable C) (x₀ : E) (t : ℝ≥0) :
    StronglyMeasurable[drivingHistoryFiltration hC t]
      (fun ω => ∫ r in 0..(t : ℝ), g (continuousLangevinVersion V C x₀ r.toNNReal ω)) := by
  let η : Measure ℝ := volume.restrict (Ioc 0 (t : ℝ))
  have : IsFiniteMeasure η := by dsimp [η]; infer_instance
  let Cext := historyNoiseExtension (d := d) t
  have hmExt : Measurable Cext := historyNoiseExtension_measurable t
  have hJ : StronglyMeasurable (Function.uncurry (fun r : ℝ => fun w : C(Icc 0 (t : ℝ), E) =>
      g (continuousLangevinVersion V Cext x₀ r.toNNReal w))) := by
    apply stronglyMeasurable_uncurry_of_continuous_of_stronglyMeasurable
    · intro w
      exact (hg.comp (continuousLangevinVersion_continuous hV κ hκ hHess Cext x₀ w)).comp continuous_real_toNNReal
    · intro r
      exact (hg.measurable.comp (continuousLangevinVersion_measurable hV κ hκ hHess hmExt x₀ _)).stronglyMeasurable
  have hQ : StronglyMeasurable (fun w : C(Icc 0 (t : ℝ), E) => ∫ r,
      g (continuousLangevinVersion V Cext x₀ r.toNNReal w) ∂η) := hJ.integral_prod_left
  have heq : (fun ω => ∫ r in 0..(t : ℝ), g (continuousLangevinVersion V C x₀ r.toNNReal ω)) =
      fun ω => ∫ r, g (continuousLangevinVersion V Cext x₀ r.toNNReal (drivingHistory C t ω)) ∂η := by
    funext ω
    calc
      _ = ∫ r in 0..(t : ℝ), g (continuousLangevinVersion V Cext x₀ r.toNNReal (drivingHistory C t ω)) := by
        apply intervalIntegral.integral_congr
        intro r hr
        have hr' : r ∈ Icc 0 (t : ℝ) :=
          ⟨(le_min le_rfl t.property).trans hr.1, hr.2.trans (max_le t.property le_rfl)⟩
        have hp := langevinSolution_eqOn_of_noise_eqOn hV κ hκ hHess (C ω).continuous
          (Cext (drivingHistory C t ω)).continuous x₀ t.property (fun a ha => ?_)
        · have hmem : ((r.toNNReal : ℝ)) ∈ Icc 0 (t : ℝ) := by
            rw [Real.coe_toNNReal _ hr'.1]
            exact hr'
          exact congrArg g (hp hmem)
        · exact (IccExtend_of_mem t.property (drivingHistory C t ω) ha).symm
      _ = _ := intervalIntegral.integral_of_le t.property
  rw [heq]
  exact hQ.comp_measurable (comap_measurable (drivingHistory C t))

/-- The actual compact-test Dynkin functional on the measurable continuous realization. -/
@[expose] noncomputable def langevinDynkinProcess (V f : E → ℝ) (C : Ω → C(ℝ, E))
    (x₀ : E) (t : ℝ≥0) (ω : Ω) : ℝ :=
  f (continuousLangevinVersion V C x₀ t ω) - f x₀ -
    ∫ r in 0..(t : ℝ), langevinDifferentialOperator V f (continuousLangevinVersion V C x₀ r.toNNReal ω)

/-- The genuine Dynkin functional is strongly adapted. -/
theorem langevinDynkinProcess_stronglyAdapted
    {V f : E → ℝ} (hV : ContDiff ℝ 2 V) (hf : ContDiff ℝ 2 f)
    (κ : ℝ) (hκ : 0 ≤ κ)
    (hHess : ∀ x z, κ * ‖z‖ ^ 2 ≤ fderiv ℝ (fderiv ℝ V) x z z)
    {C : Ω → C(ℝ, E)} (hC : Measurable C) (x₀ : E) :
    StronglyAdapted (drivingHistoryFiltration hC) (langevinDynkinProcess V f C x₀) := by
  intro t
  exact ((hf.continuous.measurable.comp
    (continuousLangevinVersion_stronglyAdapted hV κ hκ hHess hC x₀ t).measurable).stronglyMeasurable.sub
      stronglyMeasurable_const).sub
    (continuousLangevinVersion_integral_stronglyMeasurable_history hV
      (continuous_langevinDifferentialOperator hV hf) κ hκ hHess hC x₀ t)

end CutoffRigidity
