module

public import CutoffRigidity.Riemann.DiffFrComplex
public import Mathlib.Topology.UniformSpace.Dini
public import Mathlib.Analysis.SpecialFunctions.Complex.LogBounds

/-! # The `cfc` semigroup generated by a Friedrichs resolvent

Let `R` be a bounded self-adjoint operator on a real Hilbert space with `0 ≤ R ≤ 1`
(`Cx.UnitOp R`); `R` plays the role of `(1 + A)⁻¹` for a nonnegative self-adjoint operator `A`.
We put `T_t := h_t(R)` with `h_t(r) = exp(-t (1/r - 1))` (`h_t(0) = 0`, `h_0 = 1`), using the
real continuous functional calculus `Cx.rcfc`.  We prove the semigroup law, contractivity,
the implicit Euler limit `((n+1)/t · R_{(n+1)/t})^{n+1} → T_t` in operator norm (Dini), the
action on eigenvectors and the derivative formula on `ran R`.
-/

@[expose] public section

open Filter Topology Set
open scoped NNReal ENNReal InnerProductSpace

set_option linter.unusedSectionVars false

namespace CutoffRigidity.Riemann.Diff

/-- The scalar function `h_t(r) = exp(-t (1/r - 1))` for `r > 0`, `0` for `r ≤ 0`, and `h_0 = 1`. -/
noncomputable def hfun (t : ℝ≥0) (r : ℝ) : ℝ :=
  if t = 0 then 1 else if 0 < r then Real.exp (-(t : ℝ) * (r⁻¹ - 1)) else 0

lemma hfun_zero (r : ℝ) : hfun 0 r = 1 := by simp [hfun]

lemma hfun_of_pos {t : ℝ≥0} (ht : t ≠ 0) {r : ℝ} (hr : 0 < r) :
    hfun t r = Real.exp (-(t : ℝ) * (r⁻¹ - 1)) := by simp [hfun, ht, hr]

lemma hfun_of_nonpos {t : ℝ≥0} (ht : t ≠ 0) {r : ℝ} (hr : r ≤ 0) : hfun t r = 0 := by
  simp [hfun, ht, not_lt.mpr hr]

lemma hfun_nonneg (t : ℝ≥0) (r : ℝ) : 0 ≤ hfun t r := by
  unfold hfun
  split_ifs <;> first | exact zero_le_one | exact (Real.exp_pos _).le | exact le_rfl

lemma hfun_le_one (t : ℝ≥0) {r : ℝ} (hr : r ≤ 1) : hfun t r ≤ 1 := by
  unfold hfun
  split_ifs with h1 h2
  · exact le_rfl
  · apply Real.exp_le_one_iff.mpr
    have : 1 ≤ r⁻¹ := (one_le_inv₀ h2).mpr hr
    have ht : 0 ≤ (t : ℝ) := t.2
    nlinarith
  · exact zero_le_one

lemma hfun_add (s t : ℝ≥0) (r : ℝ) : hfun (s + t) r = hfun s r * hfun t r := by
  by_cases hs : s = 0
  · simp [hs, hfun_zero]
  by_cases ht : t = 0
  · simp [ht, hfun_zero]
  have hst : s + t ≠ 0 := fun h => hs (by simpa [ht] using h)
  by_cases hr : 0 < r
  · rw [hfun_of_pos hs hr, hfun_of_pos ht hr, hfun_of_pos hst hr, ← Real.exp_add]
    congr 1
    push_cast; ring
  · rw [hfun_of_nonpos hs (not_lt.mp hr)]; simp [hfun_of_nonpos hst (not_lt.mp hr)]

lemma continuous_hfun (t : ℝ≥0) : Continuous (hfun t) := by
  by_cases ht : t = 0
  · have : hfun t = fun _ => 1 := by funext r; simp [ht, hfun_zero]
    rw [this]; exact continuous_const
  rw [continuous_iff_continuousAt]
  intro r
  rcases lt_trichotomy r 0 with hr | hr | hr
  · apply continuousAt_const.congr
    filter_upwards [Iio_mem_nhds hr] with x hx
    exact (hfun_of_nonpos ht (le_of_lt hx)).symm
  · subst hr
    rw [continuousAt_iff_continuous_left_right]
    constructor
    · apply continuousWithinAt_const.congr
      · intro x hx; exact hfun_of_nonpos ht hx
      · exact hfun_of_nonpos ht le_rfl
    · rw [← continuousWithinAt_Ioi_iff_Ici]
      have h0 : hfun t 0 = 0 := hfun_of_nonpos ht le_rfl
      unfold ContinuousWithinAt
      rw [h0]
      have h1 : Tendsto (fun r : ℝ => -(t : ℝ) * (r⁻¹ - 1)) (𝓝[>] 0) atBot := by
        have hp : (0 : ℝ) < t := by positivity
        have : Tendsto (fun r : ℝ => r⁻¹ - 1) (𝓝[>] 0) atTop :=
          tendsto_atTop_add_const_right _ _ tendsto_inv_nhdsGT_zero
        have h2 := this.const_mul_atTop hp
        have := tendsto_neg_atTop_atBot.comp h2
        refine this.congr (fun r => ?_)
        simp
      have h3 := Real.tendsto_exp_atBot.comp h1
      refine h3.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with x hx
      simp [hfun_of_pos ht hx]
  · have : ContinuousAt (fun x : ℝ => Real.exp (-(t : ℝ) * (x⁻¹ - 1))) r := by
      apply Real.continuous_exp.continuousAt.comp
      exact (continuousAt_const.mul ((continuousAt_inv₀ hr.ne').sub continuousAt_const))
    apply this.congr
    filter_upwards [Ioi_mem_nhds hr] with x hx
    exact (hfun_of_pos ht hx).symm

/-! ### Scalar lemmas for the Euler scheme -/

/-- Monotonicity of `(1 + x/m)^m` in `m`. -/
lemma pow_one_add_div_le (x : ℝ) (hx : 0 ≤ x) (m : ℕ) (hm : 0 < m) :
    (1 + x / m) ^ m ≤ (1 + x / (m + 1)) ^ (m + 1) := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  set a : ℝ := 1 + x / m with ha
  set b : ℝ := 1 + x / (m + 1) with hb
  have ha0 : 0 < a := by positivity
  have hb0 : 0 < b := by positivity
  have hma : (m : ℝ) * a = m + x := by rw [ha]; field_simp
  set u : ℝ := b / a - 1 with hu
  have hu2 : -2 ≤ u := by
    have : 0 ≤ b / a := by positivity
    linarith
  have hber := one_add_mul_le_pow hu2 (m + 1)
  have hu1 : 1 + u = b / a := by rw [hu]; ring
  have key : (m + 1 : ℝ) * u = - (x / (m + x)) := by
    rw [hu, ha, hb]
    field_simp
    ring
  have h1 : 1 + ((m + 1 : ℕ) : ℝ) * u = 1 / a := by
    push_cast
    rw [key]
    have : (m + x : ℝ) ≠ 0 := by positivity
    rw [ha]; field_simp; ring
  rw [h1, hu1, div_pow] at hber
  have h2 : 1 / a ≤ b ^ (m + 1) / a ^ (m + 1) := hber
  have h3 : a ^ (m + 1) * (1 / a) ≤ b ^ (m + 1) := by
    rw [le_div_iff₀ (by positivity)] at h2
    linarith
  have h4 : a ^ (m + 1) * (1 / a) = a ^ m := by
    rw [pow_succ]; field_simp
  rw [h4] at h3
  exact h3

/-! ### The semigroup and the resolvents as functions of `R` -/

section Operators

open Cx

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The semigroup `T_t = h_t(R)`. -/
noncomputable def cfcSemigroup (R : H →L[ℝ] H) (t : ℝ≥0) : H →L[ℝ] H := rcfc (hfun t) R

/-- The scalar resolvent function `r ↦ r / (1 + (λ - 1) r)`, i.e. `(λ + r⁻¹ - 1)⁻¹`. -/
noncomputable def resFun (lam r : ℝ) : ℝ := r / (1 + (lam - 1) * r)

/-- The resolvent `R_λ = (λ + A)⁻¹` as a function of `R = (1 + A)⁻¹`. -/
noncomputable def resolventLam (R : H →L[ℝ] H) (lam : ℝ) : H →L[ℝ] H := rcfc (resFun lam) R

lemma den_pos {lam r : ℝ} (hlam : 0 < lam) (hr : r ∈ Icc (0 : ℝ) 1) : 0 < 1 + (lam - 1) * r := by
  obtain ⟨h0, h1⟩ := hr
  rcases le_total 1 lam with h | h
  · nlinarith
  · nlinarith

lemma continuousOn_resFun {lam : ℝ} (hlam : 0 < lam) : ContinuousOn (resFun lam) (Icc 0 1) := by
  apply ContinuousOn.div continuousOn_id (by fun_prop)
  intro r hr; exact (den_pos hlam hr).ne'

lemma continuousOn_hfun (t : ℝ≥0) : ContinuousOn (hfun t) (Icc 0 1) :=
  (continuous_hfun t).continuousOn

/-! ### Implicit Euler scheme -/

/-- Scalar Euler function `((λ_n R_{λ_n}))^{n+1}` with `λ_n = (n+1)/t`. -/
noncomputable def eulerFun (t : ℝ) (n : ℕ) (r : ℝ) : ℝ :=
  ((((n : ℝ) + 1) / t) * resFun (((n : ℝ) + 1) / t) r) ^ (n + 1)

lemma euler_base {t : ℝ} (ht : 0 < t) (n : ℕ) {r : ℝ} (hr : r ∈ Ioc (0 : ℝ) 1) :
    (((n : ℝ) + 1) / t) * resFun (((n : ℝ) + 1) / t) r =
      (1 + t * (r⁻¹ - 1) / ((n : ℝ) + 1))⁻¹ := by
  obtain ⟨hr0, hr1⟩ := hr
  have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  have hc : 0 < ((n : ℝ) + 1) / t := by positivity
  have hd := den_pos hc ⟨hr0.le, hr1⟩
  unfold resFun
  have e : 1 + (((n : ℝ) + 1) / t - 1) * r =
      ((n + 1) * r + t * (1 - r)) / t := by field_simp; ring
  have e2 : 1 + t * (r⁻¹ - 1) / ((n : ℝ) + 1) = ((n + 1) * r + t * (1 - r)) / ((n + 1) * r) := by
    field_simp
  rw [e2, e]
  have hpos : 0 < (n + 1 : ℝ) * r + t * (1 - r) := by nlinarith
  field_simp

lemma eulerFun_zero {t : ℝ} (n : ℕ) : eulerFun t n 0 = 0 := by
  simp [eulerFun, resFun]

lemma eulerFun_eq {t : ℝ} (ht : 0 < t) (n : ℕ) {r : ℝ} (hr : r ∈ Ioc (0 : ℝ) 1) :
    eulerFun t n r = ((1 + t * (r⁻¹ - 1) / ((n : ℝ) + 1)) ^ (n + 1))⁻¹ := by
  unfold eulerFun
  rw [euler_base ht n hr, inv_pow]

lemma eulerFun_nonneg {t : ℝ} (ht : 0 < t) (n : ℕ) {r : ℝ} (hr : r ∈ Icc (0 : ℝ) 1) :
    0 ≤ eulerFun t n r := by
  rcases hr.1.eq_or_lt with h | h
  · rw [← h, eulerFun_zero]
  · rw [eulerFun_eq ht n ⟨h, hr.2⟩]
    have : 0 ≤ r⁻¹ - 1 := by
      have := (one_le_inv₀ h).mpr hr.2
      linarith
    positivity

lemma eulerFun_antitone {t : ℝ} (ht : 0 < t) {r : ℝ} (hr : r ∈ Icc (0 : ℝ) 1) :
    Antitone (fun n => eulerFun t n r) := by
  apply antitone_nat_of_succ_le
  intro n
  rcases hr.1.eq_or_lt with h | h
  · rw [← h]; simp [eulerFun_zero]
  · have hr' : r ∈ Ioc (0 : ℝ) 1 := ⟨h, hr.2⟩
    rw [eulerFun_eq ht (n + 1) hr', eulerFun_eq ht n hr']
    have hx : 0 ≤ t * (r⁻¹ - 1) := by
      have := (one_le_inv₀ h).mpr hr.2
      have : 0 ≤ r⁻¹ - 1 := by linarith
      positivity
    have := pow_one_add_div_le (t * (r⁻¹ - 1)) hx (n + 1) (by omega)
    push_cast at this ⊢
    apply inv_anti₀ (by positivity)
    convert this using 3

lemma continuousOn_eulerFun {t : ℝ} (ht : 0 < t) (n : ℕ) : ContinuousOn (eulerFun t n) (Icc 0 1) := by
  unfold eulerFun
  apply ContinuousOn.pow
  apply ContinuousOn.mul continuousOn_const
  exact continuousOn_resFun (by positivity)

lemma tendsto_eulerFun {t : ℝ≥0} (ht : t ≠ 0) {r : ℝ} (hr : r ∈ Icc (0 : ℝ) 1) :
    Tendsto (fun n => eulerFun (t : ℝ) n r) atTop (𝓝 (hfun t r)) := by
  have htp : 0 < (t : ℝ) := by positivity
  rcases hr.1.eq_or_lt with h | h
  · rw [← h, hfun_of_nonpos ht le_rfl]
    simp [eulerFun_zero]
  · have hr' : r ∈ Ioc (0 : ℝ) 1 := ⟨h, hr.2⟩
    rw [hfun_of_pos ht h]
    set x : ℝ := (t : ℝ) * (r⁻¹ - 1) with hx
    have h1 := Real.tendsto_one_add_div_pow_exp x
    have h2 : Tendsto (fun n : ℕ => (1 + x / ((n + 1 : ℕ) : ℝ)) ^ (n + 1)) atTop (𝓝 (Real.exp x)) :=
      h1.comp (tendsto_add_atTop_nat 1)
    have h3 := h2.inv₀ (Real.exp_pos x).ne'
    have e : Real.exp (-(t : ℝ) * (r⁻¹ - 1)) = (Real.exp x)⁻¹ := by
      rw [← Real.exp_neg]; congr 1; rw [hx]; ring
    rw [e]
    refine h3.congr (fun n => ?_)
    rw [eulerFun_eq htp n hr']
    push_cast
    rfl

variable {R : H →L[ℝ] H} (hR : UnitOp R)
include hR

lemma cfcSemigroup_zero : cfcSemigroup R 0 = 1 := by
  unfold cfcSemigroup
  have : hfun 0 = fun _ => 1 := funext hfun_zero
  rw [this]; exact hR.rcfc_one

lemma cfcSemigroup_add (s t : ℝ≥0) :
    cfcSemigroup R (s + t) = cfcSemigroup R s * cfcSemigroup R t := by
  unfold cfcSemigroup
  have : hfun (s + t) = fun x => hfun s x * hfun t x := funext (hfun_add s t)
  rw [this]
  exact hR.rcfc_mul (continuousOn_hfun s) (continuousOn_hfun t)

lemma norm_cfcSemigroup_le_one (t : ℝ≥0) : ‖cfcSemigroup R t‖ ≤ 1 :=
  hR.norm_rcfc_le zero_le_one (fun x hx => by
    rw [abs_of_nonneg (hfun_nonneg t x)]; exact hfun_le_one t hx.2)

lemma cfcSemigroup_isSelfAdjoint (t : ℝ≥0) : IsSelfAdjoint (cfcSemigroup R t) :=
  hR.isSelfAdjoint_rcfc _

lemma cfcSemigroup_comm (s t : ℝ≥0) :
    cfcSemigroup R s * cfcSemigroup R t = cfcSemigroup R t * cfcSemigroup R s :=
  hR.commute_rcfc _ _

lemma cfcSemigroup_inner_nonneg (t : ℝ≥0) (x : H) : 0 ≤ inner ℝ (cfcSemigroup R t x) x :=
  hR.rcfc_inner_nonneg (fun r _ => hfun_nonneg t r) x

lemma norm_cfcSemigroup_apply_le (t : ℝ≥0) (x : H) : ‖cfcSemigroup R t x‖ ≤ ‖x‖ :=
  ((cfcSemigroup R t).le_opNorm x).trans
    (by nlinarith [norm_nonneg x, norm_cfcSemigroup_le_one hR t])

lemma resolventLam_one : resolventLam R 1 = R := by
  unfold resolventLam
  have : resFun 1 = id := by funext r; simp [resFun]
  rw [this]; exact hR.rcfc_id

lemma resolventLam_isSelfAdjoint (lam : ℝ) : IsSelfAdjoint (resolventLam R lam) :=
  hR.isSelfAdjoint_rcfc _

lemma resolventLam_inner_nonneg {lam : ℝ} (hlam : 0 < lam) (x : H) :
    0 ≤ inner ℝ (resolventLam R lam x) x :=
  hR.rcfc_inner_nonneg (fun r hr => div_nonneg hr.1 (den_pos hlam hr).le) x

lemma norm_resolventLam_le {lam : ℝ} (hlam : 0 < lam) : ‖resolventLam R lam‖ ≤ 1 / lam :=
  hR.norm_rcfc_le (by positivity) (fun r hr => by
    have hd := den_pos hlam hr
    rw [resFun, abs_of_nonneg (div_nonneg hr.1 hd.le), div_le_div_iff₀ hd hlam]
    nlinarith [hr.2])

/-- Resolvent identity `R_a - R_b = (b - a) R_a R_b`. -/
lemma resolventLam_sub {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    resolventLam R a - resolventLam R b = (b - a) • (resolventLam R a * resolventLam R b) := by
  have hca := continuousOn_resFun ha
  have hcb := continuousOn_resFun hb
  have e1 := hR.rcfc_sub hca hcb
  have e2 := hR.rcfc_mul hca hcb
  have e3 := hR.rcfc_smul (b - a) (f := fun x => resFun a x * resFun b x) (hca.mul hcb)
  unfold resolventLam
  rw [← e1, ← e2, ← e3]
  apply hR.rcfc_congr
  intro r hr
  have h1 := (den_pos ha hr).ne'
  have h2 := (den_pos hb hr).ne'
  simp only [resFun]
  have hD : (1 + (b - 1) * r) - (1 + (a - 1) * r) = (b - a) * r := by ring
  generalize 1 + (a - 1) * r = D1 at *
  generalize 1 + (b - 1) * r = D2 at *
  field_simp
  linear_combination r * hD

/-- `R_λ ((λ - 1) R + 1) = R`: the resolvent for the spectral parameter `λ`. -/
lemma resolventLam_mul {lam : ℝ} (hlam : 0 < lam) :
    resolventLam R lam * ((lam - 1) • R + 1) = R := by
  have hc : ContinuousOn (fun r : ℝ => (lam - 1) * r + 1) (Icc 0 1) := by fun_prop
  have h1 : (lam - 1) • R + 1 = rcfc (fun r : ℝ => (lam - 1) * r + 1) R := by
    have e1 := hR.rcfc_add (f := fun r : ℝ => (lam - 1) * r) (g := fun _ => (1 : ℝ))
      (by fun_prop) continuousOn_const
    have e2 := hR.rcfc_smul (lam - 1) (f := id) continuousOn_id
    rw [e1]
    have e3 : rcfc (fun r : ℝ => (lam - 1) * r) R = (lam - 1) • R := by
      have := e2
      rw [hR.rcfc_id] at this
      exact this
    rw [e3, hR.rcfc_one]
  have h2 : resolventLam R lam * rcfc (fun r : ℝ => (lam - 1) * r + 1) R =
      rcfc (fun r : ℝ => resFun lam r * ((lam - 1) * r + 1)) R :=
    (hR.rcfc_mul (continuousOn_resFun hlam) hc).symm
  rw [h1, h2]
  conv_rhs => rw [← hR.rcfc_id]
  apply hR.rcfc_congr
  intro r hr
  have h := (den_pos hlam hr).ne'
  simp only [resFun, id]
  have : (lam - 1) * r + 1 = 1 + (lam - 1) * r := by ring
  rw [this, div_mul_cancel₀ _ h]

/-- The `n`-th implicit Euler operator `((n+1)/t · R_{(n+1)/t})^{n+1}`. -/
noncomputable def eulerOp (R : H →L[ℝ] H) (t : ℝ) (n : ℕ) : H →L[ℝ] H :=
  ((((n : ℝ) + 1) / t) • resolventLam R (((n : ℝ) + 1) / t)) ^ (n + 1)

lemma eulerOp_eq {t : ℝ} (ht : 0 < t) (n : ℕ) : eulerOp R t n = rcfc (eulerFun t n) R := by
  have hc : 0 < ((n : ℝ) + 1) / t := by positivity
  have h1 : ContinuousOn (fun x => (((n : ℝ) + 1) / t) * resFun (((n : ℝ) + 1) / t) x)
      (Icc 0 1) := continuousOn_const.mul (continuousOn_resFun hc)
  have e1 := hR.rcfc_smul (((n : ℝ) + 1) / t) (continuousOn_resFun hc)
  have e2 := hR.rcfc_pow h1 (n + 1)
  unfold eulerOp eulerFun resolventLam
  rw [← e1]
  exact e2.symm

/-- **Euler limit in operator norm**: `((n+1)/t · R_{(n+1)/t})^{n+1} → T_t` for `t > 0`. -/
theorem tendsto_eulerOp (t : ℝ≥0) (ht : t ≠ 0) :
    Tendsto (fun n : ℕ => eulerOp R (t : ℝ) n) atTop (𝓝 (cfcSemigroup R t)) := by
  have htp : (0 : ℝ) < t := by positivity
  have hU : TendstoUniformlyOn (fun n r => eulerFun (t : ℝ) n r) (hfun t) atTop (Icc 0 1) :=
    Antitone.tendstoUniformlyOn_of_forall_tendsto isCompact_Icc
      (fun n => continuousOn_eulerFun htp n) (fun r hr => eulerFun_antitone htp hr)
      (continuousOn_hfun t) (fun r hr => tendsto_eulerFun ht hr)
  rw [Metric.tendsto_atTop]
  intro ε hε
  rw [Metric.tendstoUniformlyOn_iff] at hU
  obtain ⟨N, hN⟩ := eventually_atTop.mp (hU (ε / 2) (by positivity))
  refine ⟨N, fun n hn => ?_⟩
  rw [dist_eq_norm]
  have hdiff : eulerOp R (t : ℝ) n - cfcSemigroup R t =
      rcfc (fun r => eulerFun (t : ℝ) n r - hfun t r) R := by
    rw [hR.rcfc_sub (continuousOn_eulerFun htp n) (continuousOn_hfun t), ← eulerOp_eq hR htp]
    rfl
  rw [hdiff]
  have : ‖rcfc (fun r => eulerFun (t : ℝ) n r - hfun t r) R‖ ≤ ε / 2 :=
    hR.norm_rcfc_le (by positivity) (fun r hr => by
      have := hN n hn r hr
      rw [Real.dist_eq] at this
      rw [abs_sub_comm] at this
      exact this.le)
  linarith


/-- Invariance of a closed set under all the scaled resolvents `λ R_λ` (`λ > 0`) is inherited by
the semigroup (e.g. positivity preservation, `0 ≤ u ≤ 1` preservation). -/
theorem cfcSemigroup_mapsTo (C : Set H) (hC : IsClosed C)
    (hres : ∀ lam : ℝ, 0 < lam → ∀ x ∈ C, (lam • resolventLam R lam) x ∈ C)
    (t : ℝ≥0) {x : H} (hx : x ∈ C) : cfcSemigroup R t x ∈ C := by
  by_cases ht : t = 0
  · rw [ht, cfcSemigroup_zero hR]; exact hx
  have htp : (0 : ℝ) < t := by positivity
  have hpow : ∀ n : ℕ, eulerOp R (t : ℝ) n x ∈ C := by
    intro n
    unfold eulerOp
    have hstep : ∀ (k : ℕ) (y : H), y ∈ C →
        (((((n : ℝ) + 1) / t) • resolventLam R (((n : ℝ) + 1) / t)) ^ k) y ∈ C := by
      intro k
      induction k with
      | zero => intro y hy; simpa using hy
      | succ k ih =>
        intro y hy
        rw [pow_succ', mul_apply_eq_comp]
        exact hres (((n : ℝ) + 1) / t) (by positivity) _ (ih y hy)
    exact hstep (n + 1) x hx
  have hlim : Tendsto (fun n => eulerOp R (t : ℝ) n x) atTop (𝓝 (cfcSemigroup R t x)) :=
    ((ContinuousLinearMap.apply ℝ H x).continuous.tendsto _).comp (tendsto_eulerOp hR t ht)
  exact hC.mem_of_tendsto hlim (Eventually.of_forall hpow)

/-- Resolvent on eigenvectors. -/
lemma resolventLam_apply_eigen {lam a : ℝ} (hlam : 0 < lam) (ha : 0 < a) (ha1 : a ≤ 1) {u : H}
    (hu : R u = a • u) : resolventLam R lam u = (a / (1 + (lam - 1) * a)) • u := by
  have hd : 0 < 1 + (lam - 1) * a := den_pos hlam ⟨ha.le, ha1⟩
  have h := congrArg (fun T => T u) (resolventLam_mul hR hlam)
  simp only [mul_apply_eq_comp, add_apply, smul_apply, one_apply_eq_self, hu,
    Function.comp_apply] at h
  have h2 : ((lam - 1) • (a • u) + u) = (1 + (lam - 1) * a) • u := by
    rw [smul_smul, add_smul, one_smul, add_comm]
  rw [h2, map_smul] at h
  have : resolventLam R lam u = (1 + (lam - 1) * a)⁻¹ • (a • u) := by
    rw [← h, smul_smul, inv_mul_cancel₀ hd.ne', one_smul]
  rw [this, smul_smul, div_eq_inv_mul]

/-- On an eigenvector of `R` with eigenvalue `(1+c)⁻¹`, `T_t u = exp(-c t) u`. -/
theorem cfcSemigroup_eigen {c : ℝ} (hc : 0 ≤ c) {u : H} (hu : R u = (1 + c)⁻¹ • u) (t : ℝ≥0) :
    cfcSemigroup R t u = Real.exp (-c * t) • u := by
  by_cases ht : t = 0
  · rw [ht, cfcSemigroup_zero hR]; simp
  have htp : (0 : ℝ) < t := by positivity
  have ha : 0 < (1 + c)⁻¹ := by positivity
  have ha1 : (1 + c)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by linarith)
  -- the Euler operators act by scalars
  have hscal : ∀ n : ℕ, eulerOp R (t : ℝ) n u =
      ((1 + (c * t) / ((n : ℝ) + 1)) ^ (n + 1))⁻¹ • u := by
    intro n
    have hlam : (0 : ℝ) < ((n : ℝ) + 1) / t := by positivity
    have hres := resolventLam_apply_eigen hR hlam ha ha1 hu
    set κ : ℝ := (1 + (c * t) / ((n : ℝ) + 1))⁻¹ with hκ
    have hstep : ((((n : ℝ) + 1) / t) • resolventLam R (((n : ℝ) + 1) / t)) u = κ • u := by
      rw [smul_apply, hres, smul_smul]
      congr 1
      rw [hκ]
      have hn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      have h1 : (1 + c) ≠ 0 := by positivity
      have h2 : 1 + (((n : ℝ) + 1) / t - 1) * (1 + c)⁻¹ ≠ 0 :=
        (den_pos hlam ⟨ha.le, ha1⟩).ne'
      have h3 : (1 + c) + (((n : ℝ) + 1) / t - 1) ≠ 0 := by
        have : (1 + c) + (((n : ℝ) + 1) / t - 1) = c + ((n : ℝ) + 1) / t := by ring
        rw [this]; positivity
      have h4 : 1 + (c * t) / ((n : ℝ) + 1) ≠ 0 := by positivity
      field_simp
      have h6 : (t : ℝ) * (1 + c) + ((n : ℝ) + 1 - t) ≠ 0 := by
        have : (t : ℝ) * (1 + c) + ((n : ℝ) + 1 - t) = (n : ℝ) + 1 + t * c := by ring
        rw [this]; positivity
      rw [div_eq_one_iff_eq h6]; ring
    set A : H →L[ℝ] H := (((n : ℝ) + 1) / t) • resolventLam R (((n : ℝ) + 1) / t) with hA
    have hpow : ∀ k : ℕ, (A ^ k) u = κ ^ k • u := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ', mul_apply_eq_comp, ih, map_smul, hstep, smul_smul, pow_succ', mul_comm]
    unfold eulerOp
    rw [hpow (n + 1), hκ, inv_pow]
  have hlim1 : Tendsto (fun n => eulerOp R (t : ℝ) n u) atTop (𝓝 (cfcSemigroup R t u)) :=
    ((ContinuousLinearMap.apply ℝ H u).continuous.tendsto _).comp (tendsto_eulerOp hR t ht)
  have hlim2 : Tendsto (fun n : ℕ => eulerOp R (t : ℝ) n u) atTop
      (𝓝 (Real.exp (-c * t) • u)) := by
    have h1 := Real.tendsto_one_add_div_pow_exp (c * t)
    have h2 : Tendsto (fun n : ℕ => (1 + (c * t) / ((n + 1 : ℕ) : ℝ)) ^ (n + 1)) atTop
        (𝓝 (Real.exp (c * t))) := h1.comp (tendsto_add_atTop_nat 1)
    have h3 := h2.inv₀ (Real.exp_pos _).ne'
    have e : Real.exp (-c * t) = (Real.exp (c * t))⁻¹ := by
      rw [← Real.exp_neg]; congr 1; ring
    rw [e]
    refine (h3.smul_const u).congr (fun n => ?_)
    rw [hscal n]
    push_cast
    rfl
  exact tendsto_nhds_unique hlim1 hlim2


